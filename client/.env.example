# Скопируйте в client/.env.local и подставьте значения из вашего Firebase-проекта
# (Firebase Console → Project settings → General → Your apps → SDK setup and configuration).
# Эти значения публичные и безопасны для клиента.
#
# Без этих переменных сайт работает в офлайн-режиме (прогресс только в localStorage),
# авторизация отключена.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Cloudflare Worker для ИИ-проверки письменных заданий (см. cloudflare/check-essay-worker.js)
VITE_AI_ENDPOINT=https://your-worker.workers.dev/
